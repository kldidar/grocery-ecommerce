# Version control
.git/
.gitignore

# Local virtual environment (the image builds its own at /venv)
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Environment variables — never bake secrets into an image
.env

# Testing and static-analysis artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
