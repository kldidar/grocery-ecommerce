# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Optional: a signing key dedicated to JWT, separate from DJANGO_SECRET_KEY.
# Falls back to DJANGO_SECRET_KEY if left empty.
JWT_SIGNING_KEY=

# PostgreSQL
POSTGRES_DB=db_name
POSTGRES_USER=db_username
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_NAME=media
MINIO_ENDPOINT_URL=http://minio:9000

# Comma-separated list of origins allowed to make cross-origin requests
# (a future SPA or mobile app). Empty by default — same-origin only.
CORS_ALLOWED_ORIGINS=
